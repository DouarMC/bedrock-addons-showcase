{
    "format_version": "1.21.60",
    "minecraft:attachable": {
        "description": {
            "identifier": "douarmc_more_tnt:lightning_dynamite",
            "materials": {
                "default": "entity_alphatest",
                "enchanted": "entity_alphatest_glint"
            },
            "textures": {
                "default": "textures/douarmc/more_tnt/attachables/lightning_dynamite.png",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "default": "geometry.douarmc_more_tnt.dynamite"
            },
            "animations": {
                "hold_first_person": "animation.douarmc_more_tnt.dynamite.hold_first_person",
                "hold_third_person": "animation.douarmc_more_tnt.dynamite.hold_third_person",
                "thrown": "animation.douarmc_more_tnt.dynamite.thrown"
            },
            "scripts": {
                "animate": [
                    {
                        "hold_first_person": "(context.is_first_person ?? 0.0) == 1.0 && query.is_attached == true"
                    },
                    {
                        "hold_third_person": "(context.is_first_person ?? 0.0) == 0.0 && query.is_attached == true"
                    },
                    {
                        "thrown": "query.is_attached == false"
                    }
                ]
            },
            "render_controllers": [
                {
                    "controller.render.item_default": "query.is_attached == true"
                },
                {
                    "controller.render.douarmc_more_tnt.dynamite": "query.is_attached == false"
                }
            ]
        }
    }
}